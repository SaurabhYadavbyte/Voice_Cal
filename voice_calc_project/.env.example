# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# For local HTTP testing only: SESSION_COOKIE_SECURE=0
# SQLite location; leave blank for the default instance/voice_calc.sqlite3
# SQLITE_DB_PATH=/home/Voicecalc/voice-calculator/voice_calc_project/instance/voice_calc.sqlite3

# Required for new account signup and email verification (your public HTTPS website).
PUBLIC_BASE_URL=https://voicecalc.pythonanywhere.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail app password, not your normal Google account password. Keep private.
SMTP_PASSWORD=
